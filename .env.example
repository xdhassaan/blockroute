# --- Sepolia deployment ---
# RPC endpoint (get free from Alchemy, Infura, or https://sepolia.drpc.org)
SEPOLIA_RPC_URL=

# Private key of the deployer wallet (NEVER commit the real one)
# Should be a testnet-only wallet with some Sepolia ETH from a faucet
DEPLOYER_PRIVATE_KEY=

# Etherscan v2 multichain API key (single key works across Sepolia/Mainnet)
# Get one at https://etherscan.io/myapikey
ETHERSCAN_API_KEY=

# --- Test-time role addresses (for seedProducts.ts / local demos) ---
MANUFACTURER_ADDRESS=
DISTRIBUTOR_ADDRESS=
RETAILER_ADDRESS=

# --- Test-time private keys for signing receipts in seedProducts.ts ---
MANUFACTURER_PRIVATE_KEY=
DISTRIBUTOR_PRIVATE_KEY=

# Toggle gas reporting
REPORT_GAS=false
